rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // users: 본인 문서만 read, role 필드는 본인이 수정 불가(관리자만 설정)
    // managerId(담당 매니저 배정)만 HR이 화면에서 직접 갱신할 수 있다 — 그 외 필드는
    // 여전히 콘솔/관리자 스크립트 전용(계정 생성/role 변경 등).
    match /users/{uid} {
      allow read: if request.auth.uid == uid || role() in ['manager', 'hr'];
      allow update: if role() == 'hr' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerId']);
      allow create, delete: if false; // 콘솔/관리자 스크립트로만
    }

    // responses: 신입은 본인 답변이라도 create/read를 client SDK로 직접 못 한다.
    // 예전엔 request.auth.uid == userId면 create/read를 허용했는데, "프론트가 그렇게
    // 안 짜서 안 쓴다"는 건 보안 통제가 아니다 — devtools에서 idToken만 있으면 누구나
    // AI 채점(api/score.js)을 건너뛰고 임의 scores로 직접 문서를 만들 수 있었고,
    // 본인 문서를 직접 read하면 비공개 원칙인 scores도 그대로 노출됐다(외부 리뷰로
    // 발견). 생성은 반드시 Admin SDK(api/score.js)만, 조회는 반드시 /api/checkCache
    // 등 서버리스 함수만 거치도록 강제한다 — Admin SDK는 이 규칙 자체를 우회하므로
    // 정상 플로우는 전혀 영향받지 않는다.
    match /responses/{responseId} {
      allow create: if false;
      allow read: if role() in ['manager', 'hr'];
      allow update: if role() == 'hr' && request.resource.data.diff(resource.data)
                      .affectedKeys().hasOnly(['hr_comment']); // 점수는 불변, 코멘트만 추가 가능
    }

    // manager_feedback: 신입은 절대 read 불가 (평가자 익명성 원칙). 매니저는 그 중에서도
    // users/{internId}.managerId로 본인에게 배정된 신입에 대해서만 read/write 가능
    // (배정 개념이 없던 이전 버전에서는 아무 매니저나 아무 신입에 값을 저장할 수 있어,
    // 담당자가 아닌 다른 매니저가 저장하면 기존 관찰이 경고 없이 덮어써지는 문제가
    // 있었다 — 코드 리뷰로 발견, HR 배정 화면 도입과 함께 스코핑).
    match /manager_feedback/{feedbackId} {
      // read는 세 갈래: HR 전체 열람 / 배정된 매니저가 특정 신입 문서를 직접 get()하는
      // 경우(ResponseDetailPage 등) / 매니저 본인이 "내가 남긴 관찰" 목록을 managerId로
      // 쿼리하는 경우(MetaFeedbackPage.loadEntries). 마지막 조건(resource.data.managerId
      // == request.auth.uid)이 쿼리의 where("managerId","==",uid) 필터와 정확히 일치해야
      // Firestore가 list 쿼리를 허용한다 — get() 기반 조건만으로는 쿼리 자체가
      // "증명 불가"로 거부된다(단일 문서 get()에는 이 제약이 없음).
      allow read: if role() == 'hr'
                  || (role() == 'manager'
                      && get(/databases/$(database)/documents/users/$(resource.data.internId)).data.managerId == request.auth.uid)
                  || resource.data.managerId == request.auth.uid;
      allow write: if role() == 'hr'
                  || (role() == 'manager'
                      && get(/databases/$(database)/documents/users/$(request.resource.data.internId)).data.managerId == request.auth.uid);
    }

    // missions: 공개 질문 텍스트만 신입도 read, mapped 필드는 애초에
    // 이 컬렉션에 저장하지 않고 서버(api/missionBank.js)에만 둔다.
    match /missions/{missionId} {
      allow read: if request.auth != null;
      allow write: if role() == 'hr';
    }

    // reviews: 3/6개월 종합 해석(AI 생성 서사). 본인(신입) + manager/hr가 read 가능.
    // 생성은 항상 서버(api/comprehensiveReview.js, Admin SDK)만 하므로 client write는 막는다.
    match /reviews/{reviewId} {
      allow read: if role() in ['manager', 'hr'] || request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // interviews: 3/6개월 면담 결과. manager_feedback과 같은 원칙으로 신입은 절대 read 불가
    // (정식 인사 기록이며, 요약된 형태로 공유할지는 별도 프로세스로 결정).
    match /interviews/{interviewId} {
      allow read, write: if role() in ['manager', 'hr'];
    }
  }
}
